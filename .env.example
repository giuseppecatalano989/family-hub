PORT=3000
# DATA_DIR defaults to .data in the project; preserve this directory across deployments.
# DATA_DIR=/persistent/path/gestione-casa
# Automatic backups run every 24 hours while the server is running (last 7 kept).
# BACKUP_DIR defaults to DATA_DIR followed by -backups. Keep this location persistent.
# BACKUP_DIR=/persistent/path/gestione-casa-backups
# AUTO_BACKUPS=0 disables automatic backups.
# Set TRUST_PROXY=1 only when running behind a trusted HTTPS reverse proxy.
# Vercel deployment: configure DATABASE_URL (pooled Neon URL) and CRON_SECRET
# directly in the hosting's private environment settings, never as VITE_ variables.
# Cloud backup operator commands read DATABASE_URL from a private local environment.
# RESTORE_DATABASE_URL must point to a NEW PostgreSQL database without schema casa.

{
  "name": "family-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --watch server --ext mjs --signal SIGTERM --exec \"node --env-file-if-exists=.env server/index.mjs\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:cloud": "node --test tests/cloud.integration.mjs",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test:browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "backup:verify": "node server/backup-cli.mjs verify",
    "backup:restore": "node server/backup-cli.mjs restore",
    "cloud:backup": "node --env-file-if-exists=.env server/cloud-backup-cli.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "fflate": "^0.8.3",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["fra1"],
  "outputDirectory": "dist",
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "same-origin" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
  ] }, { "source": "/sw.js", "headers": [
    { "key": "Cache-Control", "value": "no-cache" }
  ] }],
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "crons": [{ "path": "/api/internal/backup", "schedule": "0 0 * * *" }, { "path": "/api/internal/notifications", "schedule": "0 17 * * *" }]
}
